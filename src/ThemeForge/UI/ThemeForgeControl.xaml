<UserControl x:Class="ThemeForge.UI.ThemeForgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ThemeForge.UI"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             d:DesignHeight="720" d:DesignWidth="380">

  <UserControl.Resources>

    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Explicit DynamicResource, not a RelativeSource binding to the UserControl.
         Inside the ListBox's generated item containers the default WPF ListBoxItem supplies
         its own Foreground (SystemColors.ControlTextBrush — black), and that is what the row
         title and description were painting with on a dark theme. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- CheckBox, RadioButton and GroupBox content is not a TextBlock, so the style above
         never reaches it. Left unset they fall back to the WPF system default, which is
         near-black — invisible on a dark tool window. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>

    <!-- Command-bar buttons: no chrome until the pointer is on them. A row of bordered grey
         boxes reads as a form; a row of glyphs reads as a tool. The hover state is the only
         affordance needed, and it comes from the shell so it tracks the VS theme. -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseDownBackgroundBeginBrushKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Themes keeps its label: it is the one control someone opens this window to press,
         and an unlabelled glyph would hide it among the utilities. -->
    <!-- Note the explicit font: FontFamily cannot be cleared with {x:Null}. WPF validates the
         property as non-null and throws on assignment, which surfaces as "Exception has been
         thrown by the target of an invocation" when the tool window is constructed — the XAML
         parse failure is never named. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background"
              Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseDownBackgroundBeginBrushKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The overflow menu's item style.
         Two rounds of this. It started as a WPF <Menu>, whose popup is chrome the shell does
         not theme, so it painted itself out of SystemColors. Replacing it with a ContextMenu
         held as a keyed resource fixed the labels and left the surface half light: the top of
         the popup showed the search box behind it and the bottom showed the item list.

         That is not a gradient — it is transparency. A ContextMenu that lives only in a
         ResourceDictionary and is handed a PlacementTarget in code never acquires an
         inheritance context, and DynamicResource resolves by walking the logical tree. With no
         parent to walk to, the EnvironmentColors keys resolved to nothing, Background stayed
         null, and the popup was literally see-through. Setting .ContextMenu on the button
         instead — via <Button.ContextMenu> below — is what gives WPF that parent link.

         The keys here are deliberately the same ones the rest of this window already paints
         with. CommandBar*Menu* keys may or may not exist in a given VS; ToolWindowBackground
         and ToolWindowText demonstrably resolve, because the tool window they name is drawn
         with them three inches away. -->
    <Style x:Key="MenuSurfaceItem" TargetType="MenuItem">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <!-- Inherited from the ContextMenu, whose Foreground is resolved in code. Referencing
           the theme key again here would reintroduce the lookup this design removed. -->
      <Setter Property="Foreground"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#30808080" />
    </Style>

    <!-- One row: the sample is painted with the item's own colours, which is the whole
         point — you read the colour instead of decoding a swatch next to a name. -->
    <DataTemplate x:Key="ItemRowTemplate">
      <Grid Margin="2,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- dirty marker -->
        <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                 Fill="#FF9C6500"
                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />

        <!-- live sample -->
        <Border Grid.Column="1" Background="{Binding PreviewBackgroundBrush}" CornerRadius="2"
                Padding="6,2" Margin="0,0,8,0">
          <TextBlock Text="{Binding Hint}" FontFamily="Consolas" FontSize="12"
                     Foreground="{Binding ForegroundBrush}" FontWeight="{Binding PreviewWeight}"
                     TextTrimming="CharacterEllipsis" />
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
          <TextBlock Text="{Binding StorageName}" FontSize="10" Opacity="0.85"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="inherited" FontSize="10" Opacity="0.85" Margin="0,0,6,0"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                     VerticalAlignment="Center"
                     Visibility="{Binding ForegroundInherited, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="!" FontWeight="Bold" Foreground="#FFCC4125" VerticalAlignment="Center"
                     Margin="0,0,6,0"
                     ToolTip="Contrast below 4.5:1 against the editor background"
                     Visibility="{Binding ContrastPoor, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ForegroundHex}" FontFamily="Consolas" FontSize="10"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                     Opacity="0.9" Width="58" TextAlignment="Right" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <Style x:Key="GroupHeaderStyle" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                         Opacity="0.9" Margin="8,10,0,3" />
              <ItemsPresenter />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>

  <!-- Bound on the control, not on the buttons: the shortcuts have to work while the focus is
       in the colour picker or the filter box, which is where it always is when you want them. -->
  <UserControl.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
    <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo" />
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="ApplicationCommands.Redo" />
  </UserControl.InputBindings>

  <UserControl.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoCommand_Executed" CanExecute="UndoCommand_CanExecute" />
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoCommand_Executed" CanExecute="RedoCommand_CanExecute" />
  </UserControl.CommandBindings>

  <DockPanel>

    <!-- Command bar: two rows, because the window is docked narrow and a single row of
         labelled buttons was wider than the pane it lives in. -->
    <Border DockPanel.Dock="Top" Padding="6,5" BorderThickness="0,0,0,1" BorderBrush="#30808080">
      <StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <Button Style="{StaticResource PrimaryButton}" Click="Presets_Click"
                  ToolTip="Browse 40 theme presets — preview them live on your open code">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Themes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                  Click="Undo_Click" IsEnabled="False" ToolTip="Undo (Ctrl+Z)" />
          <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;"
                  Click="Redo_Click" IsEnabled="False" ToolTip="Redo (Ctrl+Y)" />

          <Rectangle Width="1" Margin="4,3" Fill="#30808080" />

          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click"
                  ToolTip="Refresh the item list. Syntax items only register once a code file has been opened." />
          <Button Style="{StaticResource IconButton}" Content="&#xE777;" Click="RevertAll_Click"
                  ToolTip="Revert everything to how it was when this window opened" />

          <Button Style="{StaticResource IconButton}" Click="PaintEditor_Click"
                  ToolTip="Paint the picker's colour across the whole editor — text area, gutter, breakpoint bar, margins">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="PaintSwatch" Text="&#x25A0;" FontFamily="Segoe UI Symbol" FontSize="15"
                         VerticalAlignment="Center" />
              <TextBlock Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="11" Opacity="0.8"
                         VerticalAlignment="Center" Margin="1,0,0,0" />
            </StackPanel>
          </Button>

          <Rectangle Width="1" Margin="4,3" Fill="#30808080" />

          <Button x:Name="OverflowButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                  Click="Overflow_Click"
                  ToolTip="Import, export, and putting Visual Studio back the way it was">
            <Button.ContextMenu>
              <ContextMenu x:Name="OverflowMenu" Padding="0,4" BorderThickness="1"
                           Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                           BorderBrush="#30808080">
                <!-- The default ContextMenu template paints a fixed-width icon gutter on the
                     left out of SystemColors.MenuBarBrush — white, unthemed, and drawn over
                     the Background set above. The item template here has no gutter, so that
                     rectangle sat on top of the row labels. Nothing in this menu uses icons or
                     check marks, so the template is replaced outright with the border and the
                     items, and the surface is one colour again. -->
                <ContextMenu.Template>
                  <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                  </ControlTemplate>
                </ContextMenu.Template>
                <ContextMenu.Resources>
                  <!-- Scoped override of the implicit TextBlock style declared at the top of
                       this file. A menu item's header is a string, so the ContentPresenter
                       generates a TextBlock, and without this the outer style reaches into the
                       popup and paints it. -->
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                  </Style>
                </ContextMenu.Resources>

                <MenuItem Style="{StaticResource MenuSurfaceItem}" Header="Export palette…" Click="Export_Click" />
                <MenuItem Style="{StaticResource MenuSurfaceItem}" Header="Import palette…" Click="Import_Click" />
                <Separator Style="{StaticResource MenuSeparator}" />
                <MenuItem Style="{StaticResource MenuSurfaceItem}" Header="Forget saved theme" Click="Forget_Click"
                          ToolTip="Delete the saved theme so the next VS start shows the VS theme untouched. What is on screen now stays." />
                <MenuItem Style="{StaticResource MenuSurfaceItem}" Header="Reset to Visual Studio defaults"
                          Click="ResetToVsDefaults_Click"
                          ToolTip="Hand every colour back to the active VS theme, now and permanently — as if this extension had never run." />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>

          <TextBlock x:Name="DirtyLabel" VerticalAlignment="Center" Margin="8,0,0,0"
                     FontSize="11" Opacity="0.9" />
        </StackPanel>

        <DockPanel>
          <ToggleButton x:Name="ShowAllToggle" DockPanel.Dock="Right" Style="{StaticResource IconToggle}"
                        Content="&#xE71D;" Click="ShowAll_Click"
                        ToolTip="Show every registered classification, not just the curated list" />
          <TextBox x:Name="SearchBox" Padding="4,3" VerticalContentAlignment="Center"
                   TextChanged="SearchBox_TextChanged"
                   ToolTip="Filter by name — try 'keyword', 'string', 'method'" />
        </DockPanel>

      </StackPanel>
    </Border>

    <!-- status strip -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#30808080">
      <TextBlock x:Name="StatusLabel" FontSize="11" Opacity="0.9" TextWrapping="Wrap"
                 Text="Changes apply as you pick. Ctrl+K, Ctrl+; in the editor jumps to the colour under the caret." />
    </Border>

    <!-- One column, two rows. Docked against a code window the pane is tall and narrow, so the
         list and the picker stack instead of sitting side by side — side by side, neither half
         had room to be usable. -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="330" MinHeight="200" />
      </Grid.RowDefinitions>

      <ListBox x:Name="ItemList" Grid.Row="0"
               BorderThickness="0" Background="Transparent"
               HorizontalContentAlignment="Stretch"
               ItemTemplate="{StaticResource ItemRowTemplate}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               SelectionChanged="ItemList_SelectionChanged">
        <ListBox.GroupStyle>
          <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}" />
        </ListBox.GroupStyle>
      </ListBox>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#20808080" />

      <Border Grid.Row="2" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="#30808080">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="DetailPanel" IsEnabled="False">

            <DockPanel Margin="0,0,0,6">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton x:Name="ForegroundTarget" Content="Fore" IsChecked="True"
                             GroupName="Channel" Margin="0,0,8,0" Checked="Channel_Changed"
                             VerticalAlignment="Center" />
                <RadioButton x:Name="BackgroundTarget" Content="Back"
                             GroupName="Channel" Checked="Channel_Changed" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel>
                <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailStorage" FontSize="10" Opacity="0.8" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Border Padding="8" CornerRadius="3" Margin="0,0,0,6" BorderThickness="1"
                    BorderBrush="#30808080" Background="{Binding SelectedItem.PreviewBackgroundBrush, ElementName=ItemList}">
              <TextBlock Text="{Binding SelectedItem.Hint, ElementName=ItemList}"
                         FontFamily="Consolas" FontSize="15" TextAlignment="Center"
                         Foreground="{Binding SelectedItem.ForegroundBrush, ElementName=ItemList}"
                         FontWeight="{Binding SelectedItem.PreviewWeight, ElementName=ItemList}" />
            </Border>

            <local:ColorPicker x:Name="Picker" Margin="0,0,0,6" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <CheckBox x:Name="BoldToggle" Content="Bold" VerticalAlignment="Center"
                        Click="Bold_Click" Margin="0,0,10,0" />
              <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Inherit_Click"
                      ToolTip="Inherit — hand this channel back to the theme" />
              <Button Style="{StaticResource IconButton}" Content="&#xE777;" Click="RevertOne_Click"
                      ToolTip="Revert this item only" />
            </StackPanel>

            <TextBlock x:Name="ContrastLabel" FontSize="11" TextWrapping="Wrap" Opacity="0.95" />
            <TextBlock Text="Storage only persists bold — italic comes from MEF format definitions and cannot be set here."
                       FontSize="10" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
