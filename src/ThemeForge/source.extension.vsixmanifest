<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- The Identity Id is deliberately unchanged. It is the upgrade key: change it and the
         next install is a second extension sitting beside the old one rather than an update
         of it, with two tool windows and two appliers fighting over the same format maps. -->
    <Identity Id="ThemeForge.7d3f1a20-9c44-4e7b-9f1e-2b6a8c5d3e01" Version="1.1.0" Language="en-US" Publisher="Xaimaran" />
    <DisplayName>XoCrazy</DisplayName>
    <Description xml:space="preserve">Live editor color editing for Visual Studio. Pick a color and the editor repaints instantly - no OK button, no 400-item list, no "Default" placeholders. Put the caret on a token and XoCrazy tells you which classification actually paints it. Other theme extensions ship you someone else's theme; XoCrazy hands the colors to you. View &gt; Other Windows &gt; XoCrazy - Live Colors.</Description>
    <MoreInfo>https://github.com/</MoreInfo>
    <Icon>assets\images\favicon-96x96.png</Icon>
    <PreviewImage>assets\images\favicon-96x96.png</PreviewImage>
    <Tags>theme, colors, fonts and colors, editor, syntax highlighting</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <!-- VsPackage only. XoCrazy consumes MEF services through IComponentModel but exports
         nothing, so declaring a MefComponent asset would just add the assembly to the
         composition scan for no benefit. -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
