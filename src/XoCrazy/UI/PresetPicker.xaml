<Window x:Class="XoCrazy.UI.PresetPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Theme presets" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">

  <Window.Resources>

    <!-- Same reason as the tool window: ListBoxItem supplies its own near-black Foreground,
         which is unreadable on a dark shell theme. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- One of the three slot boxes.
         A ToggleButton rather than a RadioButton with a custom template: the box has to carry
         a title, the name of the palette assigned to it, and a selected state, and a radio
         control's chrome fights all three. Mutual exclusion is enforced in code, which is
         also where the slot switch has to be handled anyway. -->
    <Style x:Key="SlotBox" TargetType="ToggleButton">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" CornerRadius="4" BorderThickness="1" BorderBrush="#40808080"
                    Background="#14808080" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#80808080" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF3C9DD8" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                <Setter TargetName="Chrome" Property="Background" Value="#283C9DD8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One card: the palette painted as the code it will produce. A row of swatches tells
         you the hues; a rendered sample tells you whether you can read it, which is the
         question you are actually asking. -->
    <DataTemplate x:Key="PresetCardTemplate">
      <Border Padding="10" CornerRadius="3" BorderThickness="1" BorderBrush="#30808080"
              Background="{Binding BackgroundBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                         Foreground="{Binding ForegroundBrush}" VerticalAlignment="Center" />

              <!-- The badges. This is how a card says "you already chose me, and for what" —
                   the thing that was missing when reopening the dialog looked like a fresh
                   start every time. -->
              <ItemsControl ItemsSource="{Binding Badges}" Margin="8,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,4,0"
                            Background="#FF3C9DD8">
                      <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="White" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding Origin}" FontSize="10" Opacity="0.75" Margin="0,0,0,8"
                       Foreground="{Binding ForegroundBrush}" />

            <TextBlock FontFamily="Consolas" FontSize="12" LineHeight="17"
                       Visibility="{Binding SampleVisibility}">
              <Run Text="  1  " Foreground="{Binding LineNumberBrush}" />
              <Run Text="public " Foreground="{Binding KeywordBrush}" />
              <Run Text="sealed " Foreground="{Binding KeywordBrush}" />
              <Run Text="class " Foreground="{Binding KeywordBrush}" />
              <Run Text="Widget " Foreground="{Binding TypeBrush}" />
              <Run Text=": " Foreground="{Binding OperatorBrush}" />
              <Run Text="IPart" Foreground="{Binding InterfaceBrush}" />
              <LineBreak />
              <Run Text="  2      " Foreground="{Binding LineNumberBrush}" />
              <Run Text="// the sample is painted in the preset's own colours" Foreground="{Binding CommentBrush}" />
              <LineBreak />
              <Run Text="  3      " Foreground="{Binding LineNumberBrush}" />
              <Run Text="public " Foreground="{Binding KeywordBrush}" />
              <Run Text="int " Foreground="{Binding KeywordBrush}" />
              <Run Text="Count " Foreground="{Binding PropertyBrush}" />
              <Run Text="=&gt; " Foreground="{Binding OperatorBrush}" />
              <Run Text="_items" Foreground="{Binding FieldBrush}" />
              <Run Text="." Foreground="{Binding OperatorBrush}" />
              <Run Text="Length" Foreground="{Binding PropertyBrush}" />
              <Run Text=";" Foreground="{Binding ForegroundBrush}" />
              <LineBreak />
              <Run Text="  4      " Foreground="{Binding LineNumberBrush}" />
              <Run Text="if " Foreground="{Binding ControlBrush}" />
              <Run Text="(" Foreground="{Binding ForegroundBrush}" />
              <Run Text="Count " Foreground="{Binding PropertyBrush}" />
              <Run Text="&gt; " Foreground="{Binding OperatorBrush}" />
              <Run Text="42" Foreground="{Binding NumberBrush}" />
              <Run Text=") " Foreground="{Binding ForegroundBrush}" />
              <Run Text="Log" Foreground="{Binding MethodBrush}" />
              <Run Text="(" Foreground="{Binding ForegroundBrush}" />
              <Run Text="&quot;too many&quot;" Foreground="{Binding StringBrush}" />
              <Run Text=");" Foreground="{Binding ForegroundBrush}" />
              <LineBreak />
              <Run Text="  5      " Foreground="{Binding LineNumberBrush}" />
              <Run Text="selected text" Foreground="{Binding ForegroundBrush}"
                   Background="{Binding SelectionBrush}" />
            </TextBlock>

            <TextBlock Text="{Binding NoneDescription}" TextWrapping="Wrap" FontSize="11"
                       Opacity="0.85" Visibility="{Binding NoneVisibility}"
                       Foreground="{Binding ForegroundBrush}" />
          </StackPanel>

          <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}" VerticalAlignment="Center"
                        Margin="12,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Width="88" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="18" Height="18" Margin="2" CornerRadius="2"
                        Background="{Binding Brush}" ToolTip="{Binding Label}"
                        BorderThickness="1" BorderBrush="#40808080" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="10">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock TextWrapping="Wrap" Opacity="0.9" FontSize="11" Margin="0,0,0,8"
                 Text="Three separate choices. Pick a box, then pick a palette for it — each box remembers its own. Nothing is saved until you press Apply; Cancel puts the editor back exactly as it was." />

      <UniformGrid Rows="1" Margin="0,0,0,4">
        <ToggleButton x:Name="SlotForeground" Style="{StaticResource SlotBox}" Click="Slot_Click"
                      ToolTip="Syntax colours — keyword, string, type, comment. Never touches a background.">
          <StackPanel>
            <TextBlock Text="Foreground" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="SlotForegroundValue" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </ToggleButton>

        <ToggleButton x:Name="SlotTextArea" Style="{StaticResource SlotBox}" Click="Slot_Click"
                      ToolTip="The code area's background, the selection, and the collapsed-region block.">
          <StackPanel>
            <TextBlock Text="Text area" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="SlotTextAreaValue" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </ToggleButton>

        <ToggleButton x:Name="SlotEditor" Style="{StaticResource SlotBox}" Click="Slot_Click"
                      Margin="0"
                      ToolTip="Everything around the code — gutter, breakpoint bar, outlining strip, overview margin.">
          <StackPanel>
            <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="SlotEditorValue" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </ToggleButton>
      </UniformGrid>

      <TextBlock x:Name="SlotHint" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,8,0,0">
      <TextBlock x:Name="HintLabel" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                 Opacity="0.85" />
      <Button Content="Apply" Padding="12,4" Margin="0,0,6,0" IsDefault="True" Click="Apply_Click" />
      <Button Content="Cancel" Padding="12,4" IsCancel="True" Click="Cancel_Click" />
    </StackPanel>

    <ListBox x:Name="PresetList" BorderThickness="0" Background="Transparent"
             ItemTemplate="{StaticResource PresetCardTemplate}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="PresetList_SelectionChanged" />
  </DockPanel>
</Window>
