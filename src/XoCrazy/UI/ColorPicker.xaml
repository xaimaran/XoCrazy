<UserControl x:Class="XoCrazy.UI.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="260">
  <UserControl.Resources>
    <Style x:Key="TinyButton" TargetType="Button">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Resources>

  <StackPanel>

    <!-- Saturation / value field -->
    <Grid x:Name="SvField" Height="120" Margin="0,0,0,6"
          MouseLeftButtonDown="SvField_MouseLeftButtonDown"
          MouseMove="SvField_MouseMove"
          MouseLeftButtonUp="SvField_MouseLeftButtonUp"
          Cursor="Cross" ClipToBounds="True">
      <Rectangle x:Name="HueLayer" />
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FFFFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Canvas>
        <Ellipse x:Name="SvThumb" Width="12" Height="12" IsHitTestVisible="False"
                 Stroke="White" StrokeThickness="2">
          <Ellipse.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8" Color="Black" />
          </Ellipse.Effect>
        </Ellipse>
      </Canvas>
    </Grid>

    <!-- Hue -->
    <Grid Height="16" Margin="0,0,0,6">
      <Rectangle RadiusX="2" RadiusY="2">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.000" Color="#FF0000" />
            <GradientStop Offset="0.167" Color="#FFFF00" />
            <GradientStop Offset="0.333" Color="#00FF00" />
            <GradientStop Offset="0.500" Color="#00FFFF" />
            <GradientStop Offset="0.667" Color="#0000FF" />
            <GradientStop Offset="0.833" Color="#FF00FF" />
            <GradientStop Offset="1.000" Color="#FF0000" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Opacity="0.01"
              ValueChanged="HueSlider_ValueChanged"
              PreviewMouseLeftButtonUp="Commit_MouseUp" />
      <Border x:Name="HueMarker" Width="3" Height="16" Background="White" HorizontalAlignment="Left"
              IsHitTestVisible="False" BorderBrush="#80000000" BorderThickness="1,0" />
    </Grid>

    <!-- Hex + eyedropper -->
    <DockPanel Margin="0,0,0,6" LastChildFill="True">
      <Button x:Name="EyedropperButton" DockPanel.Dock="Right" Style="{StaticResource TinyButton}"
              Margin="4,0,0,0" Click="Eyedropper_Click"
              ToolTip="Pick a colour from anywhere on screen (Esc cancels)">Pick</Button>
      <Button x:Name="TransparentButton" DockPanel.Dock="Right" Style="{StaticResource TinyButton}"
              Margin="4,0,0,0" Click="Transparent_Click"
              ToolTip="Transparent — clear this channel so whatever is behind shows through. In the editor that is the same thing as inheriting: a format with no brush is not painted at all.">Clear</Button>

      <!-- The swatch sits on a checkerboard so a cleared channel reads as transparent rather
           than as "black". Without it there is no way to tell an unpainted channel from one
           deliberately set to #000000, which on a dark theme look identical. -->
      <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,4,0"
              BorderBrush="#60808080" BorderThickness="1" CornerRadius="2">
        <Grid>
          <Rectangle x:Name="TransparencyChecker" />
          <Rectangle x:Name="CurrentSwatch" />
        </Grid>
      </Border>
      <TextBox x:Name="HexBox" VerticalContentAlignment="Center"
               KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
    </DockPanel>

    <!-- Harmony -->
    <DockPanel Margin="0,0,0,4">
      <ComboBox x:Name="HarmonyMode" Width="110" DockPanel.Dock="Left"
                SelectionChanged="HarmonyMode_SelectionChanged">
        <ComboBoxItem Content="Monochrome" IsSelected="True" />
        <ComboBoxItem Content="Analogous" />
        <ComboBoxItem Content="Complement" />
        <ComboBoxItem Content="Triad" />
      </ComboBox>
      <ItemsControl x:Name="HarmonyStrip" Margin="6,0,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Height="22" Margin="1" CornerRadius="2" BorderBrush="#60808080" BorderThickness="1"
                    Background="{Binding Brush}" Cursor="Hand"
                    MouseLeftButtonUp="Swatch_Click" Tag="{Binding Value}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Recents -->
    <TextBlock Text="Recent" Opacity="0.6" FontSize="10" Margin="0,4,0,2" />
    <ItemsControl x:Name="RecentStrip">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Width="20" Height="20" Margin="1" CornerRadius="2" BorderBrush="#60808080" BorderThickness="1"
                  Background="{Binding Brush}" Cursor="Hand" ToolTip="{Binding Hex}"
                  MouseLeftButtonUp="Swatch_Click" Tag="{Binding Value}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
