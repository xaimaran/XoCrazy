<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidXoCrazyPackage">
    <Groups>
      <!-- View > Other Windows is where tool windows live and where people look for them. -->
      <Group guid="guidXoCrazyCmdSet" id="OtherWindowsGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
      </Group>
      <!-- Also on Tools, next to Options, since that is where the colour dialog lives. -->
      <Group guid="guidXoCrazyCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLS_OPTIONS" />
      </Group>
      <Group guid="guidXoCrazyCmdSet" id="EditorContextGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidXoCrazyCmdSet" id="cmdidOpenToolWindow" priority="0x0100" type="Button">
        <Parent guid="guidXoCrazyCmdSet" id="OtherWindowsGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings>
          <ButtonText>XoCrazy — Live Colors</ButtonText>
        </Strings>
      </Button>

      <!-- Same command, second placement. CommandWellOnly keeps it out of the command well
           duplicate list; the shell handles one command appearing in two groups. -->
      <Button guid="guidXoCrazyCmdSet" id="cmdidOpenToolWindowTools" priority="0x0100" type="Button">
        <Parent guid="guidXoCrazyCmdSet" id="ToolsMenuGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings>
          <ButtonText>XoCrazy — Live Colors</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidXoCrazyCmdSet" id="cmdidTargetCaret" priority="0x0100" type="Button">
        <Parent guid="guidXoCrazyCmdSet" id="EditorContextGroup" />
        <CommandFlag>TextOnly</CommandFlag>
        <Strings>
          <ButtonText>Open XoCrazy</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <!-- Ctrl+K, Ctrl+; : jump straight to the classification under the caret. -->
    <KeyBinding guid="guidXoCrazyCmdSet" id="cmdidTargetCaret"
                editor="guidVSStd97" key1="K" mod1="Control" key2="VK_OEM_1" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidXoCrazyPackage" value="{7d3f1a20-9c44-4e7b-9f1e-2b6a8c5d3e01}" />
    <GuidSymbol name="guidXoCrazyCmdSet" value="{7d3f1a20-9c44-4e7b-9f1e-2b6a8c5d3e03}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="EditorContextGroup" value="0x1021" />
      <IDSymbol name="OtherWindowsGroup" value="0x1022" />
      <IDSymbol name="cmdidOpenToolWindow" value="0x0100" />
      <IDSymbol name="cmdidTargetCaret" value="0x0101" />
      <IDSymbol name="cmdidOpenToolWindowTools" value="0x0102" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
