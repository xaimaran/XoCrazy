<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <MinimumVisualStudioVersion>18.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{7D3F1A20-9C44-4E7B-9F1E-2B6A8C5D3E10}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>XoCrazy</RootNamespace>
    <AssemblyName>XoCrazy</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!--
      Emits "CodeBase"="$PackageFolder$\XoCrazy.dll" into the pkgdef instead of a bare
      "Assembly" string. The assembly is not strong-named, so without a CodeBase the shell
      cannot bind it — and since Menus.ctmenu is an embedded resource in that assembly, the
      command table silently never loads and no menu items appear.
    -->
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <LangVersion>7.3</LangVersion>
    <!-- Non-SDK projects do not infer this, and without it restore silently does nothing. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <DeployExtension>true</DeployExtension>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- IComponentModel.DefaultExportProvider is a MEF ExportProvider; without this the
         format-definition metadata walk in FontColorNameMap will not compile. -->
    <Reference Include="System.ComponentModel.Composition" />
    <!-- OleMenuCommandService derives from System.ComponentModel.Design.MenuCommandService,
         which lives in System.Design. Without it the base members are invisible. -->
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core\CaretTargeting.cs" />
    <Compile Include="Core\ClassificationCatalog.cs" />
    <Compile Include="Core\ColorMath.cs" />
    <Compile Include="Core\Diag.cs" />
    <Compile Include="Core\ColorResolver.cs" />
    <Compile Include="Core\EditorFormatBridge.cs" />
    <Compile Include="Core\EditHistory.cs" />
    <Compile Include="Core\FontColorNameMap.cs" />
    <Compile Include="Core\FontColorStore.cs" />
    <Compile Include="Core\ItemViewModel.cs" />
    <Compile Include="Core\Json.cs" />
    <Compile Include="Core\LiveApplyQueue.cs" />
    <Compile Include="Core\PresetSelection.cs" />
    <Compile Include="Core\PristineStore.cs" />
    <Compile Include="Core\Snapshot.cs" />
    <Compile Include="Core\SurfaceCatalog.cs" />
    <Compile Include="Core\ThemeApplier.cs" />
    <Compile Include="Core\XoCrazySession.cs" />
    <Compile Include="Core\ThemePresets.cs" />
    <Compile Include="Core\ThemeStore.cs" />
    <Compile Include="PackageGuids.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="XoCrazyPackage.cs" />
    <Compile Include="UI\ColorPicker.xaml.cs">
      <DependentUpon>ColorPicker.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\Eyedropper.cs" />
    <Compile Include="UI\PresetPicker.xaml.cs">
      <DependentUpon>PresetPicker.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\XoCrazyControl.xaml.cs">
      <DependentUpon>XoCrazyControl.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\XoCrazyToolWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="UI\ColorPicker.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\PresetPicker.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="UI\XoCrazyControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The marketplace icon and preview tile. Both point at the same file: the manifest wants
         a small icon and a larger preview, and one square logo answers both — VS scales it. -->
    <Content Include="assets\images\favicon-96x96.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="XoCrazy.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
      <Generator>
      </Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK">
      <Version>17.14.40265</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <Version>18.8.739</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
  <!--
    Exists() rather than a plain path check: the WPF markup-compile pass forks a temporary
    "*_wpftmp.csproj", and NuGet's generated props are keyed to the *original* file name, so
    VSToolsPath is unset in that fork. The temp project only compiles generated XAML code and
    has no use for the VSSDK targets, so skipping the import there is correct, not a workaround.
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>